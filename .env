APP_ENV=dev
APP_DEBUG=1
APP_SECRET=ThisTokenIsNotSoSecretSetUsingEnvironmentVariables
TRUSTED_PROXIES=
TRUSTED_HOSTS=

COMPOSER_HOME=var/composer
COMPOSER_CACHE=var/composer/cache
COMPOSER_FUND=0
COMPOSER_HTACCESS_PROTECT=0
COMPOSER_MEMORY_LIMIT=1g
COMPOSER_NO_AUDIT=1

SATIS_CONFIG="%kernel.project_dir%/satis.json"
SATIS_LOG="%kernel.project_dir%/var/satis"

# Where webhooks and the admin UI queue builds for satisfy:worker,
# and how many seconds one Satis build may run.
SATISFY_QUEUE_DIR="%kernel.project_dir%/var/queue"
SATISFY_BUILD_TIMEOUT=600

# Plugins to enable, comma-separated: authz, hookgate, or a bundle class.
SATISFY_PLUGINS=

GITHUB_SECRET=
GITLAB_SECRET=
GITEA_SECRET=
DEVOPS_SECRET=
BITBUCKET_SECRET=

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
